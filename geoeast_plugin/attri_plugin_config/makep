DEFINES += FW_QT5_SUPPORT

win32 {
    QT += network
    CONFIG += c++17
    QMAKE_CFLAGS += -utf-8
    QMAKE_CXXFLAGS += -utf-8
    QMAKE_CXXFLAGS += /std:c++17
    QMAKE_CXXFLAGS *= /MP
    DEFINES += WIN32
    DEFINES += FW_QT5_SUPPORT
    DEFINES += NGP_SUP
    DEFINES += NOMINMAX
    DEFINES += _HAS_STD_BYTE=0
    DEFINES += _SILENCE_STDEXT_HASH_DEPRECATION_WARNINGS
}

BASE_MAKE_PATH = $$(BASE_MAKE_PATH)
isEmpty(BASE_MAKE_PATH) {
    BASE_MAKE_PATH = $$(GEOEAST)
}

GGI_MAKE_PATH = $$(GGI_MAKE_PATH)
isEmpty(GGI_MAKE_PATH) {
    GGI_MAKE_PATH = $$(GEOEAST)
}

win32 {
    GGI_BIN_PATH = $$join(GGI_MAKE_PATH,,,/bin)
}

INCLUDEPATH += $(NGP)/include/ncp
INCLUDEPATH += $(NGP)/include/ndp/core
INCLUDEPATH += $(NGP)/include/ndp/bdo
INCLUDEPATH += $(NGP)/include/ndp/bdo/seis
INCLUDEPATH += $(NGP)/include/ndp/bo
INCLUDEPATH += $(NGP)/include/common
INCLUDEPATH += $(NGP)/include/common/ggeometry
INCLUDEPATH += $(NGP)/include/common/gsm
